{contentType application/xml; charset=utf-8}
<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="{link //stylesheet}" ?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
        <url n:foreach="$sitemap as $url">
            <lastmod n:if="$url['lastModified']">{$url['lastModified']|date:'c'}</lastmod>
            <changefreq n:if="$url['changeFrequency'] !== null">{$url['changeFrequency']}</changefreq>
            <priority n:if="$url['priority'] !== null">{$url['priority']}</priority>
            <loc>{$url['location']}</loc>
            <xhtml:link n:foreach="$url['alternates'] as $alternate"
                    rel="alternate"
                    hreflang="{$alternate['languageCode']}"
                    href="{$alternate['location']}"
            />
        </url>
</urlset>
