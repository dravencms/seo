<form n:name="form" class="card">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="name">{_"seo.admin.field.name"}</label>
                    <input type="text" n:name="name" autofocus="autofocus" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="position">{_"seo.admin.field.position"}</label>
                    <select type="text" n:name="position" class="form-control"></select>
                </div>
            </div><!-- col-sm-6 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-12">

                <div class="mb-3">
                    <label class="form-label" n:name="code">{_"seo.admin.field.code"}</label>
                    <div class="alert alert-info">{_"seo.admin.help.trackingCode"}</div>
                    <textarea type="text" n:name="code" class="form-control"></textarea>
                </div>
            </div><!-- col-sm-12 -->
        </div><!-- row -->
    </div>

    <div class="card-footer">
        <input type="submit" n:name="send" class="btn btn-success button" value="{_"seo.admin.action.save"}">
    </div>
</form>
